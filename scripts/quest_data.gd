class_name QuestData
## The story of "Οι Περιπέτειες του Γιώργου στον Άγιο Βλάση": NPCs, quests and dialogue.
## All text is Greek. Edit freely - the quest manager (quests.gd) reads this data.
##
## Quest objective types:
##   {"type": "kill",    "target": "skeleton" | "rogue" | "mage" | "brute" | "captain" | "king" | "totem" | "bandit" | "bandit_chief" | "cultist" | "cult_priest", "count": N, "text": "..."}
##   {"type": "collect", "item": "<item id>",                       "count": N, "text": "..."}
##   {"type": "defend",  "count": 1, "text": "..."}                  (survive a night invasion)
##   {"type": "reach",   "place": "catacombs" | "frontier" | "ashvalley" | "village", "count": 1, "text": "..."}   (Quests.report_reach)
##   {"type": "rescue",  "count": 1, "text": "..."}                  (Quests.report_rescue; with "event": true on the quest nobody hands out: rescue.gd starts it)
## Kill targets also include the catacomb creatures "cguard", "acolyte", "warden_bone",
## "warden_flame", "warden_shadow" and "necromancer" (enemies.gd KINDS).
## Where the quest items stand in the world is set in village.gd (QUEST_ITEMS).

## Creatures that are not skeletons: the totems, the creatures made from props and the people of the cult. The bandits are
## told apart by their name (`bandit_...`). The quests that ask for "skeletons" (target "skeleton") count every other kill.
const NOT_SKELETONS: Array[String] = ["totem", "pumpkin", "haunted_tree", "golem", "bone_heap", "mimic", "cultist", "cult_priest", "magma_golem", "dark_knight", "witch", "thief", "raider", "cursed_coffin", "ash_lord", "cursed_scarecrow", "cinder_guardian", "cinder_archon", "orc_warrior", "orc_berserker", "orc_warlord", "wolf", "spider", "warband_totem", "orc_catapult", "pirate_corsair", "pirate_captain", "gladiator_recruit", "arena_gorgor", "arena_drake", "arena_vorgthul", "arena_titan", "arena_balthazar"]


static func is_skeleton(kind: String) -> bool:
	return not (kind in NOT_SKELETONS) and not kind.begins_with("bandit")


## A bandit of the forest hideout (the chief has his own target "bandit_chief").
static func is_bandit(kind: String) -> bool:
	return kind.begins_with("bandit_") and kind != "bandit_chief"


## An orc of the eastern warband (the warlord has his own target "orc_warlord").
static func is_orc(kind: String) -> bool:
	return kind.begins_with("orc_") and kind != "orc_warlord"


