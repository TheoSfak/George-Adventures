class_name SoundManager
extends Node
## All the game's audio: sound-effect pools (2D and positional), the music that follows
## what is happening (crossfaded), and the ambience layers (birds, crickets, wind, tavern
## chatter...). The sounds are generated by tools/gen_audio.py into assets/audio/.
##
## Music, by priority: inside a building (tavern / church / calm) > night invasion >
## boss fight > fighting skeletons > crypt area > the wilds > night > day.
## F7 switches the music on/off, F8 the sound effects and ambience.

const SFX_DIR := "res://assets/audio/sfx/"
const MUSIC_DIR := "res://assets/audio/music/"
const POOL_2D := 14
const POOL_3D := 22
const MUSIC_FADE := 2.5
const MUSIC_MIN_DWELL := 4.0           # seconds a track plays before another may replace it
const COMBAT_HOLD := 6.0              # seconds the fight music lingers after the last attacker
const CRYPT := Vector2(0.0, -178.0)
const CAMP := Vector2(-175.0, 20.0)
const POND := Vector2(-70.0, 108.0)

# minimum seconds between two plays of the same sound (keeps rapid events from stacking)
const MIN_GAP := {
	"footstep_grass": 0.12, "footstep_stone": 0.12, "footstep_wood": 0.12, "footstep_heavy": 0.15,
	"gold_pickup": 0.06, "sword_hit": 0.05, "skel_hurt": 0.06, "skel_attack": 0.1, "dialogue_blip": 0.0,
	"voice_blip": 0.2, "ui_hover": 0.05, "arrow_hit": 0.05, "orb_hit": 0.05, "block_hit": 0.1,
}
# loudness trims (dB) for sounds that are too loud/quiet for their role
const TRIM := {"footstep_grass": -3.0, "footstep_stone": -2.0, "footstep_wood": -2.0, "ui_click": -4.0, "dialogue_blip": -4.0}

var music_on := true
var sfx_on := true

var _streams := {}
var _pool_2d: Array[AudioStreamPlayer] = []
var _pool_3d: Array[AudioStreamPlayer3D] = []
var _next_2d := 0
var _next_3d := 0
var _last_played := {}               # sound id -> msec
var _last_variant := {}              # sound id -> variant number

var _music: Array[AudioStreamPlayer] = []
var _music_front := 0
var _music_id := ""
var _music_switched := -100.0
var _music_tweens: Array[Tween] = []
var _music_check := 0.0
var _combat_until := 0.0
var _boss_until := 0.0
var _ambient := {}                   # layer id -> AudioStreamPlayer
var _player: Node3D
var _daynight: DayNight
var _invasion
var _interiors
var _critter_timer := 20.0


func _ready() -> void:
	add_to_group("sound_manager")
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup_buses()
	for i in POOL_2D:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool_2d.append(p)
	for i in POOL_3D:
		var p3 := AudioStreamPlayer3D.new()
		p3.bus = "SFX"
		p3.unit_size = 9.0
		p3.max_distance = 80.0
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		add_child(p3)
		_pool_3d.append(p3)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.bus = "Music"
		m.volume_db = -60.0
		add_child(m)
		_music.append(m)
	for id in ["amb_day", "amb_night", "wind_loop", "amb_tavern", "amb_church", "amb_crypt"]:
		var a := AudioStreamPlayer.new()
		a.bus = "Ambient"
		a.stream = _loop_stream(SFX_DIR + id + ".wav")
		a.volume_db = -60.0
		add_child(a)
		a.play()
		_ambient[id] = a
	_add_positional_loop("fire_loop", Vector3(CAMP.x, 1.2, CAMP.y), 7.0, 45.0, -2.0)
	_add_positional_loop("water_loop", Vector3(POND.x, 0.5, POND.y), 8.0, 40.0, -4.0)
	_add_positional_loop("wind_loop", Vector3(CRYPT.x, 6.0, CRYPT.y), 14.0, 60.0, -10.0)
	# the sounds used most are loaded up front so the first swing does not stutter
	for id in SfxIds.VARIANTS:
		if not SfxIds.LOOPS.has(id) and SfxIds.VARIANTS[id] > 0:
			for v in SfxIds.VARIANTS[id]:
				_stream(_file(id, v + 1))


func _setup_buses() -> void:
	for bus in ["Music", "SFX", "Ambient"]:
		if AudioServer.get_bus_index(bus) == -1:
			AudioServer.add_bus()
			var idx := AudioServer.bus_count - 1
			AudioServer.set_bus_name(idx, bus)
			AudioServer.set_bus_send(idx, "Master")
	GameSettings.apply_audio()          # volumes and output device from user://settings.json


func _add_positional_loop(id: String, pos: Vector3, unit: float, max_dist: float, db: float) -> void:
	var p := AudioStreamPlayer3D.new()
	p.bus = "Ambient"
	p.stream = _loop_stream(SFX_DIR + id + ".wav")
	p.unit_size = unit
	p.max_distance = max_dist
	p.volume_db = db
	p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
	p.autoplay = true
	add_child(p)
	p.global_position = pos


# ------------------------------------------------------------------ loading ----

func _file(id: String, variant: int) -> String:
	var count: int = SfxIds.VARIANTS.get(id, 0)
	return SFX_DIR + (id + ".wav" if count == 1 else "%s_%d.wav" % [id, variant])


func _stream(path: String) -> AudioStream:
	if not _streams.has(path):
		_streams[path] = load(path) if ResourceLoader.exists(path) else null
		if _streams[path] == null:
			push_warning("SoundManager: missing sound %s" % path)
	return _streams[path]


func _loop_stream(path: String) -> AudioStream:
	var s := _stream(path)
	if s is AudioStreamWAV:
		var wav := s as AudioStreamWAV
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = wav.data.size() / (2 * (2 if wav.stereo else 1))
	return s


# --------------------------------------------------------------- sound effects ----

## Plays a sound effect. `at` = Vector3.INF for a flat (interface) sound, otherwise a
## position in the world. pitch < 0 means "exactly as recorded" (no random variation).
func play(id: String, at: Vector3 = Vector3.INF, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	if not sfx_on:
		return
	var count: int = SfxIds.VARIANTS.get(id, 0)
	if count == 0:
		push_warning("SoundManager: unknown sound '%s'" % id)
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_played.get(id, -100000)) < int(float(MIN_GAP.get(id, 0.03)) * 1000.0):
		return
	_last_played[id] = now
	var variant := randi_range(1, count)
	if count > 1 and variant == int(_last_variant.get(id, 0)):
		variant = variant % count + 1          # never the same variant twice in a row
	_last_variant[id] = variant
	var stream := _stream(_file(id, variant))
	if stream == null:
		return
	var pitch_scale := 1.0 if pitch < 0.0 else pitch * randf_range(0.95, 1.05)
	var db := volume_db + float(TRIM.get(id, 0.0))
	if at == Vector3.INF:
		var p := _pool_2d[_next_2d]
		_next_2d = (_next_2d + 1) % POOL_2D
		p.stream = stream
		p.volume_db = db
		p.pitch_scale = pitch_scale
		p.play()
	else:
		var p3 := _pool_3d[_next_3d]
		_next_3d = (_next_3d + 1) % POOL_3D
		p3.stream = stream
		p3.volume_db = db
		p3.pitch_scale = pitch_scale
		p3.global_position = at
		p3.play()


# ----------------------------------------------------------------------- music ----

func _set_music(id: String) -> void:
	if id == _music_id:
		return
	var now := Time.get_ticks_msec() / 1000.0
	var urgent := id == "combat" or id == "boss" or id == "invasion"
	if _music_id != "" and not urgent and now - _music_switched < MUSIC_MIN_DWELL:
		return                          # no rapid back-and-forth between calm tracks
	var stream := _loop_stream(MUSIC_DIR + id + ".wav")
	if stream == null:
		return
	_music_id = id
	_music_switched = now
	for t in _music_tweens:
		if t != null:
			t.kill()
	_music_tweens.clear()
	var old := _music[_music_front]
	_music_front = 1 - _music_front
	var fresh := _music[_music_front]
	fresh.stream = stream
	fresh.volume_db = -50.0
	fresh.play()
	var tween := create_tween().set_parallel(true)
	tween.tween_property(fresh, "volume_db", 0.0, MUSIC_FADE)
	tween.tween_property(old, "volume_db", -60.0, MUSIC_FADE)
	tween.chain().tween_callback(old.stop)
	_music_tweens.append(tween)


func _pick_music() -> String:
	if _interiors != null and _interiors.is_inside():
		match String(_interiors.current_kind):
			"tavern":
				return "tavern"
			"church":
				return "church"
			_:
				return "night"
	var now := Time.get_ticks_msec() / 1000.0
	if _invasion != null and _invasion.active:
		return "invasion"
	var fighting := false
	var boss := false
	for e in get_tree().get_nodes_in_group("enemies"):
		var state: int = e.get("_state")
		if state < 2 or state > 4:      # CHASE, ATTACK, HURT
			continue
		var d: float = e.global_position.distance_to(_player.global_position)
		if d <= 24.0:
			fighting = true
		var kind: String = e.get("kind_id")
		if d <= 45.0 and (kind == "captain" or kind == "king" or kind == "warlord"):
			boss = true
	if fighting:
		_combat_until = now + COMBAT_HOLD
	if boss:
		_boss_until = now + COMBAT_HOLD
	if now < _boss_until:
		return "boss"
	if now < _combat_until:
		return "combat"
	var flat := Vector2(_player.global_position.x, _player.global_position.z)
	if flat.distance_to(CRYPT) < 62.0:
		return "crypt"
	if flat.length() > 105.0:
		return "wild"
	if _daynight != null and _daynight.darkness() > 0.6:
		return "night"
	return "day"


# -------------------------------------------------------------------- ambience ----

func _update_ambience(delta: float) -> void:
	var dark := _daynight.darkness() if _daynight != null else 0.0
	var inside: bool = _interiors != null and _interiors.is_inside()
	var kind := String(_interiors.current_kind) if inside else ""
	var flat := Vector2(_player.global_position.x, _player.global_position.z)
	var near_crypt := not inside and flat.distance_to(CRYPT) < 55.0
	var out := 0.0 if (inside or not sfx_on) else 1.0
	var target := {
		"amb_day": -4.0 if out > 0.0 and not near_crypt else -60.0,
		"amb_night": -4.0 if out > 0.0 and dark > 0.5 and not near_crypt else -60.0,
		"wind_loop": -12.0 if out > 0.0 else -60.0,
		"amb_tavern": -3.0 if inside and kind == "tavern" and sfx_on else -60.0,
		"amb_church": -6.0 if inside and kind == "church" and sfx_on else -60.0,
		"amb_crypt": -2.0 if near_crypt and sfx_on else -60.0,
	}
	# the day layer fades with the light, the night layer with the dark
	if out > 0.0 and not near_crypt:
		target["amb_day"] = lerpf(-4.0, -45.0, clampf(dark * 1.4, 0.0, 1.0))
		target["amb_night"] = lerpf(-45.0, -4.0, clampf(dark * 1.4 - 0.3, 0.0, 1.0))
	for id in _ambient:
		var a: AudioStreamPlayer = _ambient[id]
		a.volume_db = move_toward(a.volume_db, target[id], 30.0 * delta)


## Now and then something calls from the dark: a wolf howl, an owl; a rooster at dawn.
func _update_critters(delta: float) -> void:
	_critter_timer -= delta
	if _critter_timer > 0.0 or _daynight == null or _player == null:
		return
	_critter_timer = randf_range(25.0, 60.0)
	if _interiors != null and _interiors.is_inside():
		return
	var around := Vector3(randf_range(-1, 1), 0.0, randf_range(-1, 1)).normalized() * randf_range(40.0, 70.0)
	if _daynight.darkness() > 0.8:
		Sfx.play(["wolf_howl", "owl_hoot", "owl_hoot"][randi() % 3], _player.global_position + around + Vector3.UP * 3.0, -2.0)


func on_dawn() -> void:
	Sfx.play("rooster", Vector3.INF, -4.0, -1.0)


# ------------------------------------------------------------------------ loop ----

func _process(delta: float) -> void:
	if _player == null:
		_player = get_tree().get_first_node_in_group("player") as Node3D
		_daynight = get_tree().get_first_node_in_group("daynight") as DayNight
		_invasion = get_tree().get_first_node_in_group("invasion")
		_interiors = get_tree().get_first_node_in_group("interiors")
		if _daynight != null:
			_daynight.dawn_started.connect(on_dawn)
			_daynight.dusk_started.connect(func(): Sfx.play("bell_toll", Vector3.INF, -6.0, -1.0))
		return
	_update_ambience(delta)
	_update_critters(delta)
	_music_check -= delta
	if _music_check <= 0.0:
		_music_check = 0.5
		_set_music(_pick_music())


func _unhandled_key_input(event: InputEvent) -> void:
	var key := event as InputEventKey
	if key == null or not key.pressed or key.echo:
		return
	var hud := get_tree().get_first_node_in_group("hud")
	if key.physical_keycode == KEY_F7:
		music_on = not music_on
		AudioServer.set_bus_mute(AudioServer.get_bus_index("Music"), not music_on)
		if hud:
			hud.show_message(Strings.MUSIC_ON if music_on else Strings.MUSIC_OFF)
	elif key.physical_keycode == KEY_F9:
		var devices := AudioServer.get_output_device_list()
		var next := (devices.find(AudioServer.output_device) + 1) % devices.size()
		AudioServer.output_device = devices[next]
		Sfx.ui("bell_toll")
		if hud:
			hud.show_message(Strings.AUDIO_DEVICE % AudioServer.output_device)
	elif key.physical_keycode == KEY_F8:
		sfx_on = not sfx_on
		AudioServer.set_bus_mute(AudioServer.get_bus_index("SFX"), not sfx_on)
		AudioServer.set_bus_mute(AudioServer.get_bus_index("Ambient"), not sfx_on)
		if hud:
			hud.show_message(Strings.SFX_ON if sfx_on else Strings.SFX_OFF)
